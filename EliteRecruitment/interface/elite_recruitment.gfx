spriteTypes = {

	# CK2 shows the sprite named GFX_<decision_name> as that decision's icon.
	# Bespoke art for the Recruit an Elite Specialist decision: a red wax seal
	# impressed with a laurel wreath on aged parchment, painted to match the
	# vanilla decision-icon style. 28x28 uncompressed BGRA DDS, matching
	# vanilla's native decision-icon size. Players running Proper4KUI can
	# install the optional Elite Recruitment - Proper4KUI Patch sub-mod, which
	# overrides this file with a 50x50 hi-res version via load-order resolution
	# (the engine renders decision icons at native pixel size, so the patch's
	# later-loaded file wins).

	spriteType = {
		name = "GFX_recruit_elite_specialist"
		texturefile = "gfx\\interface\\elite_recruitment_specialist_decision.dds"
	}
}
